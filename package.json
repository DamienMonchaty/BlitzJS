{
  "name": "@damienmonchaty/blitzjs",
  "version": "1.0.0",
  "description": "Ultra-fast, runtime-agnostic HTTP framework (Node, Bun, uWebSockets.js)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "publish:dry": "npm publish --dry-run",
    "publish:public": "npm publish --access=public"
  },
  "keywords": [
    "http",
    "framework",
    "fast",
    "web",
    "server",
    "api",
    "typescript",
    "uwebsockets",
    "elysia",
    "performance"
  ],
  "author": "Formation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formation/blitzjs.git"
  },
  "homepage": "https://github.com/formation/blitzjs#readme",
  "bugs": {
    "url": "https://github.com/formation/blitzjs/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "uWebSockets.js": ">=20.67.0"
  },
  "peerDependenciesMeta": {
    "uWebSockets.js": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "autocannon": "^8.0.0",
    "elysia": "^1.4.29",
    "fastify": "^5.11.2",
    "swagger-ui-dist": "^5.32.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.7",
    "typescript": "^5.8.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0",
    "zod": "^4.4.3"
  }
}
